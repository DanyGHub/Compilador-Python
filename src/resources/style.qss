QMainWindow {
    background-color: #1e2233;
}
/* MenuBar */
QMenuBar {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #050a1a, stop:1 #00004f);
    color: white;
    padding: 5px;
    font-weight: bold;
}

QMenuBar::item:selected {
    background-color: rgba(255, 255, 255, 0.2);
}

/* Barra de Actividad Izquierda */
#activityBar {
    background-color: #2d334a;
    border-right: 1px solid #121520;
}

#activityBar QPushButton {
    background-color: transparent;
    border-radius: 5px;
    color: #a0a0a0;
    font-size: 20px;
    margin: 5px;
}

#activityBar QPushButton:hover {
    background-color: #3d4461;
    color: white;
}

/* Explorador de Archivos y Paneles Laterales */
#sideBarProject, #rightAccessBar {
    background-color: #1e2233;
    border: 1px solid #2d334a;
    color: white;
}

/* Editores de Texto */
QPlainTextEdit {
    background-color: #1e2233;
    color: #d1d1d1;
    border: none;
    selection-background-color: #3b3bff;
}

#lineNumberArea {
    background-color: #1e2233;
    color: #5a5f73;
    border-right: 1px solid #2d334a;
}

/* Pestañas (TabWidgets) */
QTabWidget::pane {
    border: 1px solid #2d334a;
    background-color: #1e2233;
}

QTabBar::tab {
    background-color: #121520;
    color: #a0a0a0;
    padding: 8px 15px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #2d334a;
    color: white;
    border-bottom: 2px solid #3b3bff;
}

/* Botones de Compilación (Derecha) */
#rightAccessBar QPushButton {
    background-color: #2d334a;
    color: white;
    border-radius: 0px;
    padding: 10px;
    border-bottom: 1px solid #1e2233;
}

#rightAccessBar QPushButton:hover {
    background-color: #3b3bff;
}

/* Encabezado del editor */
#editorHeader {
    background-color: #121520;
    border-bottom: 1px solid #2d334a;
}

#lblCurrentFileName {
    color: #ffffff;
    padding: 5px 10px;
    background-color: #1e2233; 
    border-top: 2px solid #3b3bff;
}

#btnRunCode {
    background-color: transparent;
    color: #00ff88;
    border: none;
    font-size: 16px;
}

#btnRunCode:hover {
    background-color: rgba(0, 255, 136, 0.1);
    border-radius: 4px;
}

/* Estilo para el área de numeración en todas las pestañas */
QPlainTextEdit[lineNumbers="true"] {
    background-color: #353535;
    color: #ffffff;
    border: none;

    padding-left: 5px;
    qproperty-cursorWidth: 0; /* Oculta el cursor en la numeración */
}

/* Estilo para el editor de código en todas las pestañas */
QPlainTextEdit[codeEditor="true"] {
    background-color: #1e1e1e;
    color: #d4d4d4;
    border: none;
}

/* Estilo para el contenedor de la pestaña */
QWidget#tabContainer {
    background-color: #1e1e1e;
}

/* Panel lateral derecho */
#rightAnalysisPanel {
    background-color: #1e1e1e;
    border-left: 1px solid #333333;
}

/* Encabezado del análisis (Azul resaltado como en VS Code) */
#analysisHeader {
    background-color: #252526;
    color: #007acc;
    font-weight: bold;
    border-bottom: 2px solid #007acc;
    text-transform: uppercase;
    font-size: 10px;
}

/* Terminal interna */
#subTerminal {
    background-color: #151515;
    color: #d4d4d4;
    border: none;
}